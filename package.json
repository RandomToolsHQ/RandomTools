{
  "name": "randomtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.api.toml",
    "build": "tsc --noEmit && vite build && node scripts/seo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts",
    "db:migrate": "wrangler d1 migrations apply randomtools --config wrangler.api.toml --local",
    "format": "prettier --write src worker tests e2e functions scripts *.ts *.json *.js",
    "build:pages": "npm run build && node scripts/hosting.mjs && wrangler pages functions build --outdir dist/_worker.js",
    "build:staging": "node scripts/staging.mjs",
    "build:public-staging": "node scripts/public-staging.mjs",
    "preview:pages": "wrangler pages dev dist --port 8790",
    "check:backup": "node scripts/check-backup.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@clerk/react": "^6.18.4",
    "@noble/hashes": "latest",
    "@tanstack/react-query": "latest",
    "diff": "latest",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "motion": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.6.6",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "eslint": "latest",
    "jsdom": "latest",
    "miniflare": "^5.20261023.3-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
