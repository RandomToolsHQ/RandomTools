{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": [
    "src",
    "worker",
    "functions",
    "staging/guard.ts",
    "tests",
    "experiments/firebase",
    "experiments/supabase",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.public.config.ts",
    "playwright.private.config.ts",
    "playwright.firebase.config.ts",
    "private-e2e"
  ]
}
