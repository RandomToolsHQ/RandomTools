# Reference only. Create an IGNORED .dev.vars.supabase-poc locally when ready.
# All credentials must be NEW and prototype-only. Never copy .dev.vars.staging.
POC_ENABLED=false
POC_PROJECT_REF=REPLACE_WITH_ISOLATED_PROJECT_REF
POC_ORIGIN=http://127.0.0.1:54380
POC_ACCESS_KEY=REPLACE_WITH_NEW_RANDOM_32_BYTE_HEX_KEY
POC_CLERK_SECRET_KEY=REPLACE_WITH_DEDICATED_DEVELOPMENT_KEY
POC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_DEDICATED_DEVELOPMENT_PUBLIC_KEY
POC_CLERK_ISSUER=https://REPLACE.clerk.accounts.dev
POC_SYNTHETIC_TESTERS={"user_REPLACEALICE":"alice+clerk_test@example.com","user_REPLACEBOB":"bob+clerk_test@example.com","user_REPLACEADMIN":"admin+clerk_test@example.com"}
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted runtime.
# Do not upload Cloudflare gateway keys, a genuine session, or real account data.
